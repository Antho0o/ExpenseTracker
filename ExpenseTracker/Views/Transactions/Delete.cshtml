@model ExpenseTracker.Models.Transaction

@{
    ViewData["Title"] = "Delete Transaction";
}

<div class="container expense-page">

    <div class="dashboard-hero">

        <div>

            <div class="dashboard-eyebrow danger-eyebrow">
                PERMANENT ACTION
            </div>

            <h1>
                Delete Transaction
            </h1>

            <p>
                Review the transaction before permanently deleting it.
            </p>

        </div>

    </div>


    <div class="delete-card">

        <div class="delete-icon">
            !
        </div>


        <h2>
            Are you sure?
        </h2>

        <p class="delete-description">
            This action cannot be undone.
            The transaction will be permanently removed.
        </p>


        <div class="delete-transaction">

            <div>

                <span>
                    Description
                </span>

                <strong>
                    @Model.Description
                </strong>

            </div>


            <div>

                <span>
                    Category
                </span>

                <strong>
                    @Model.Category
                </strong>

            </div>


            <div>

                <span>
                    Date
                </span>

                <strong>
                    @Model.Date.ToString("dd MMM yyyy")
                </strong>

            </div>


            <div>

                <span>
                    Amount
                </span>

                @if (Model.Type == "Income")
                {

                    <strong class="amount-income">

                        +R @Model.Amount.ToString("N2")

                    </strong>

                }
                else
                {

                    <strong class="amount-expense">

                        -R @Model.Amount.ToString("N2")

                    </strong>

                }

            </div>

        </div>


        <form asp-action="Delete"
              method="post">

            <input type="hidden"
                   asp-for="Id" />


            <div class="form-actions">

                <button type="submit"
                        class="expense-btn expense-btn-danger">

                    Delete Transaction

                </button>

                <a asp-action="Index"
                   class="expense-btn expense-btn-secondary">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>