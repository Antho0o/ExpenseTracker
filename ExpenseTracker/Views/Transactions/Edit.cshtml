@model ExpenseTracker.Models.Transaction

@{
    ViewData["Title"] = "Edit Transaction";
}

<div class="container expense-page">

    <div class="dashboard-hero">

        <div>

            <div class="dashboard-eyebrow">
                TRANSACTION MANAGEMENT
            </div>

            <h1>
                Edit Transaction
            </h1>

            <p>
                Update the details of this transaction.
            </p>

        </div>

    </div>


    <div class="form-layout">

        <div class="expense-form-card">

            <form asp-action="Edit"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />


                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors">
                </div>


                <!-- Description -->

                <div class="expense-form-group">

                    <label asp-for="Description"
                           class="expense-form-label">

                        Description

                    </label>

                    <input asp-for="Description"
                           class="expense-form-control" />

                    <span asp-validation-for="Description"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- Amount -->

                <div class="expense-form-group">

                    <label asp-for="Amount"
                           class="expense-form-label">

                        Amount

                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            R
                        </span>

                        <input asp-for="Amount"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control" />

                    </div>

                    <span asp-validation-for="Amount"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- Category -->

                <div class="expense-form-group">

                    <label asp-for="Category"
                           class="expense-form-label">

                        Category

                    </label>

                    <select asp-for="Category"
                            class="expense-form-control">

                        <option value="">
                            Select a category
                        </option>

                        <optgroup label="Income">

                            <option value="Salary">
                                Salary
                            </option>

                            <option value="Freelance">
                                Freelance
                            </option>

                            <option value="Business">
                                Business
                            </option>

                            <option value="Investment">
                                Investment
                            </option>

                            <option value="Other Income">
                                Other Income
                            </option>

                        </optgroup>

                        <optgroup label="Expenses">

                            <option value="Food">
                                Food
                            </option>

                            <option value="Transport">
                                Transport
                            </option>

                            <option value="Shopping">
                                Shopping
                            </option>

                            <option value="Entertainment">
                                Entertainment
                            </option>

                            <option value="Bills">
                                Bills
                            </option>

                            <option value="Rent">
                                Rent
                            </option>

                            <option value="Health">
                                Health
                            </option>

                            <option value="Education">
                                Education
                            </option>

                            <option value="Other Expense">
                                Other Expense
                            </option>

                        </optgroup>

                    </select>

                    <span asp-validation-for="Category"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- Type -->

                <div class="expense-form-group">

                    <label asp-for="Type"
                           class="expense-form-label">

                        Transaction Type

                    </label>

                    <select asp-for="Type"
                            class="expense-form-control">

                        <option value="Income">
                            Income
                        </option>

                        <option value="Expense">
                            Expense
                        </option>

                    </select>

                    <span asp-validation-for="Type"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- Date -->

                <div class="expense-form-group">

                    <label asp-for="Date"
                           class="expense-form-label">

                        Date

                    </label>

                    <input asp-for="Date"
                           type="date"
                           class="expense-form-control" />

                    <span asp-validation-for="Date"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- Notes -->

                <div class="expense-form-group">

                    <label asp-for="Notes"
                           class="expense-form-label">

                        Notes

                        <span class="optional-text">
                            Optional
                        </span>

                    </label>

                    <textarea asp-for="Notes"
                              class="expense-form-control"
                              maxlength="500"></textarea>

                    <span asp-validation-for="Notes"
                          class="field-validation-error">
                    </span>

                </div>


                <div class="form-actions">

                    <button type="submit"
                            class="expense-btn expense-btn-primary">

                        Save Changes

                    </button>

                    <a asp-action="Index"
                       class="expense-btn expense-btn-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}